# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=Evidence Analysis System
APP_VERSION=1.0.0
DEBUG=False

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://evidence_user:your_password_here@localhost:5432/evidence_analysis

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate a secure secret key (use: openssl rand -hex 32)
JWT_SECRET_KEY=your_jwt_secret_key_here_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# CORS ORIGINS
# ============================================
# JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ============================================
# EXECUTION DEFAULTS
# ============================================
DEFAULT_TENANT_CODE=default
DEFAULT_ORGANIZATION_CODE=default_code

# ============================================
# ENTITY MANAGEMENT SERVICE
# ============================================
# Base URL for external entity management service
ENTITY_MGMT_BASE_URL=https://dev.elevate-apis.shikshalokam.org

# Mandatory upstream headers (currently required by Entity Management service)
ENTITY_MGMT_TENANT_ID=shikshalokam
ENTITY_MGMT_ORIGIN=https://dev.elevate-sandbox.shikshalokam.org

# Reliability settings
ENTITY_MGMT_TIMEOUT_SECONDS=10
ENTITY_MGMT_RETRY_ATTEMPTS=2
ENTITY_MGMT_RETRY_BACKOFF_SECONDS=0.5

# Optional in-memory cache for /states endpoint
ENTITY_MGMT_CACHE_ENABLED=true
ENTITY_MGMT_STATES_CACHE_TTL_SECONDS=900

# ============================================
# FILE STORAGE CONFIGURATION
# ============================================
# Standardized cloud config (use only CLOUD_* keys)
# Provider: gcp | aws
CLOUD_STORAGE_PROVIDER=gcp

# Display/type label used by API responses (e.g., GCP, AWS, LOCAL)
CLOUD_STORAGE=GCP

# Provider-specific account identifier:
# - GCP: service-account email
# - AWS: access key id
CLOUD_STORAGE_ACCOUNTNAME=your-account-or-service-account

# Bucket settings
CLOUD_STORAGE_BUCKETNAME=your-bucket-name
CLOUD_STORAGE_BUCKET_TYPE=private

# Region / project hint:
# - AWS: set region (example: us-east-1)
# - GCP: optional (can be empty if full service-account JSON is supplied in CLOUD_STORAGE_SECRET)
CLOUD_STORAGE_REGION=

# Optional endpoint override:
# - AWS: custom S3-compatible endpoint if needed
# - GCP: optional token URI override
CLOUD_ENDPOINT=

# Provider secret:
# - GCP: service-account JSON string OR private key
# - AWS: secret access key
CLOUD_STORAGE_SECRET=

# Local storage path (not used when CLOUD_STORAGE_PROVIDER is gcp/aws)
LOCAL_STORAGE_PATH=./uploads

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================
# Select provider: google (default) | openrouter
LLM_PROVIDER=google

# ── Google Gemini ────────────────────────────
# Multiple API keys supported for rotation (at least one required when LLM_PROVIDER=google)
# Optional: use comma-separated keys instead of numbered vars
# GEMINI_API_KEYS=key_a,key_b,key_c
GEMINI_API_KEY_1=your_gemini_api_key_1
GEMINI_API_KEY_2=your_gemini_api_key_2
GEMINI_API_KEY_3=your_gemini_api_key_3
GEMINI_MODEL=gemini-2.5-flash

# ── OpenRouter (via OpenAI SDK) ──────────────
# Required when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
# Model to use via OpenRouter (any model slug listed on openrouter.ai)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# Enable/disable email notifications
IS_NOTIFICATION_ENABLED=true

# If IS_NOTIFICATION_ENABLED=true, the following SMTP settings are mandatory:
# For SendGrid SMTP, use:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_USER=apikey
# SMTP_API_KEY=SG.xxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_API_KEY=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
SMTP_MAX_RETRIES=3
SMTP_RETRY_BACKOFF_SECONDS=1
SMTP_FROM_EMAIL=noreply@evidence-analysis.com
SMTP_FROM_NAME=Evidence Analysis System
PORTAL_BASE_URL=http://localhost:5173

# ============================================
# BACKGROUND PROCESSING
# ============================================
MAX_CONCURRENT_JOBS=5
WORKER_CHECK_INTERVAL=5

# Celery + RabbitMQ
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=rpc://
CELERY_TASK_QUEUE=execution_queue
CELERY_TASK_ROUTING_KEY=execution.process
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_SECONDS=30
CELERY_WORKER_CONCURRENCY=2

# Execution workspace + scripts
EXECUTION_WORKSPACE_ROOT=/tmp/evidence_analysis/executions
EXECUTION_CLEANUP_ON_SUCCESS=true
PREPROCESS_SCRIPT_PATH=scripts/pre-processor/1-pre-processor.py
PROCESSOR_SCRIPT_PATH=scripts/processor/1-main-parallel-script.py
PROCESSOR_MAX_ROWS=0
PROCESSOR_RESUME_FROM_CHECKPOINT=false
ESTIMATED_COST_PER_INPUT_ROW=0.001
ESTIMATED_TIME_SECONDS_PER_INPUT_ROW=0.5

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=[".csv"]
SIGNED_UPLOAD_URL_EXPIRY_SECONDS=900
SIGNED_DOWNLOAD_URL_EXPIRY_SECONDS=600

# Interactive criteria validation
CRITERIA_VALIDATE_MAX_ITEMS=25
